---
import Table from '../../../site/src/components/Table.astro';
import { reportData, reportSnapshots } from '../../../site/src/lib/report-data';
import { formatTableNumber as n } from '../../../site/src/lib/table-number';
const networks = ['ping', 'coba'];
const names = { ping: 'PING', coba: 'COBA' };
const data = await reportData('exp176', { allowUnavailable: true });
const evidence = await reportSnapshots('exp176', { snapshots: Object.fromEntries(
  networks.map(network => [network, `${network}/frozen/start/snapshot.json`])
), allowUnavailable: true });
const cfg = evidence?.configuration;
const snaps = evidence?.snapshots ?? {};
const available = data && cfg && networks.every(network => snaps[network]);
const graph = network => snaps[network].network;
const pop = (network, id) => graph(network).populations.find(p => p.id === id);
const math = id => ({ math: { E: 'E', I: 'I', readout: 'R', drive: 'X' }[id] });
const row = (label, read) => [label, ...networks.map(read)];
const rule = network => data.rules[network];
const seconds = cfg ? cfg.presentations * cfg.presentation_ms / 1000 : 0;
const groups = available ? [
  { label: 'Simulation', rows: [
    row('Integration timestep', network => `${n(graph(network).timebase.dt.value)} ms`),
    row('Stream', () => `${String(cfg.presentations)} × ${n(cfg.presentation_ms)} ms = ${n(seconds)} s; continuous state`),
    row('Checkpoint / stream encoder seed', () => `${String(cfg.seed)} / ${String(cfg.stream_encoder_seed)}`),
    row('Source cell', network => `${cfg.source_cells[network]}; ${cfg.checkpoint_role}`),
  ] },
  { label: 'Populations', rows: [
    row(math('drive'), network => `${n(graph(network).inputs.find(p => p.id === 'drive').shape.at(-1))} sensory channels`),
    ...['E', 'I', 'readout'].map(id => row(math(id), network => pop(network, id) ? `${n(pop(network, id).size)} ${pop(network, id).neuron.kind}` : 'Absent')),
  ] },
  { label: 'Neuron dynamics', rows: [
    row('E / I membrane time constant', network => `${n(pop(network, 'E').neuron.tau_mem.value)} / ${pop(network, 'I') ? n(pop(network, 'I').neuron.tau_mem.value) : '–'} ms`),
    row('E / I refractory period', network => `${n(pop(network, 'E').neuron.refractory.value)} / ${pop(network, 'I') ? n(pop(network, 'I').neuron.refractory.value) : '–'} ms`),
    row('Readout time constant', network => `${n(pop(network, 'readout').neuron.tau.value)} ms`),
  ] },
  { label: 'Input and plasticity', rows: [
    row('Peak sensory rate', () => `${n(cfg.input_rate_hz)} Hz/channel`),
    row('AMPA / GABA decay', () => `${n(cfg.tau_ampa_ms)} / ${n(cfg.tau_gaba_ms)} ms`),
    row('Plastic projection', () => 'X→E only'),
    row('STDP window τ / depression c_d', () => `${n(cfg.stdp_tau_ms)} ms / ${n(cfg.stdp_depression_fraction)}`),
    row('STDP a₊ / a₋', network => `${n(rule(network).a_plus_us)} / ${n(rule(network).a_minus_us)} µS`),
    row('Weight bounds / fixed point', network => `[0, ${n(rule(network).w_max_us)}] / ${n(rule(network).equilibrium_us)} µS`),
    row('Scaling target ν*', network => `${n(data.scaling_target_rate_hz[network])} Hz`),
    row('Scaling τ_ν / β / γ', () => `${n(cfg.scaling_tau_rate_ms / 1000)} s / ${n(cfg.scaling_beta)} / ${n(cfg.scaling_gamma)}`),
  ] },
  { label: 'Measurement', rows: [
    row('ISI and spectrum blocks', () => `${n(cfg.isi_block_presentations)} presentations (${n(cfg.isi_block_presentations * cfg.presentation_ms / 1000)} s)`),
    row('Rhythm band', () => `${n(cfg.rhythm_band_hz[0])}–${n(cfg.rhythm_band_hz[1])} Hz`),
    row('Rhythmicity (exp054)', () => data.rhythmicity_settings ? `autocorrelogram to ${n(data.rhythmicity_settings.max_lag_ms)} ms, ${n(data.rhythmicity_settings.bin_ms)}-ms bins, first ${n(data.rhythmicity_settings.burn_ms)} ms skipped` : 'unavailable'),
    row('Accuracy images / seeds', () => `${n(cfg.accuracy_images)} official test / ${String(cfg.accuracy_sample_seed)}, ${String(cfg.accuracy_encoder_seed)}`),
    row('Accuracy schedule', () => `every ${String(cfg.accuracy_every)} presentations; frozen weights, fresh state per image`),
    row('Tracked synapses / seed', () => `${n(cfg.tracked_synapses)} X→E per network / ${String(cfg.tracked_synapse_seed)}`),
  ] },
] : [];
const symbols = { input_to_E: 'EX', E_to_I: 'IE', I_to_E: 'EI', readout_projection: 'RE' };
const matrices = available ? networks.map(network => {
  const net = graph(network);
  const sources = [...net.inputs, ...net.populations.filter(p => p.id !== 'readout')];
  const endpoint = value => value.split('.')[0];
  const weights = data.results[network].van_rossum.weights;
  return { network, headers: ['Source ↓ / target →', ...net.populations.map(p => math(p.id))],
    rows: sources.map(source => [math(source.id), ...net.populations.map(target => {
      const projection = net.projections.find(p => endpoint(p.source) === source.id && endpoint(p.target) === target.id);
      if (!projection) return 'Absent';
      if (!snaps[network].parameters[projection.parameters[0]]) throw new Error('Missing executed weight array');
      const symbol = `W_{${symbols[projection.id]},ji}`;
      if (projection.id === 'input_to_E') {
        return { math: `${n(100)}\\%;\\quad ${symbol}(t),\\ ${n(weights.mean_us[0])} \\pm ${n(weights.std_us[0])}\\,\\mathrm{\\mu S}\\ \\text{at start}` };
      }
      return { math: `${n(100)}\\%;\\quad ${symbol}\\,\\mathrm{\\mu S}` };
    })]),
  };
}) : [];
---
{available ? <>
<Table headers={['Parameter', ...networks.map(network => names[network])]} groups={groups} number="C1" id="parameters" label="Recorded native dynamics, rule and protocol">
  X is sensory input, E excitatory, I inhibitory, R readout. Quantities use two
  significant figures; seeds and cell names are exact. The same settings apply to
  the frozen and van Rossum conditions of each network; only X→E differs between
  them, and only through plasticity. Settings come from the selected compute
  configuration and its native start snapshots.
</Table>
{matrices.map((matrix, i) => <Table headers={matrix.headers} rows={matrix.rows} rowHeaders number={`C${i + 2}`} label={`${names[matrix.network]} connectivity at simulation start`}>
  Rows are sources; columns are targets. Cells give eligible-pair density and the
  executed per-connection weight, kept in the native start snapshot. W subscripts
  name target then source; j and i index target and source neurons. X→E shows the
  measured mean ± standard deviation of the trained matrix at the start of the
  stream; it changes over time only in the van Rossum condition. Zeros in learned
  arrays remain eligible connections. Absent means no projection.
</Table>)}
</> : <p>Native parameter evidence is unavailable.</p>}
