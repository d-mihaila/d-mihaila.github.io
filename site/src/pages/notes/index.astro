---
import Page from '../../layouts/Page.astro';
import { siteName } from '../../lib/site';
import ArticleBrowser from '../../components/ArticleBrowser.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Page title="Notes" description={`Project notes and operational guides from ${siteName}.`} compact>
  <ArticleBrowser posts={posts} collection="notes" />
</Page>
